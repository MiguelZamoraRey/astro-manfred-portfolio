---
import Section from '@/components/Section.astro';

import { experience, manfredSpecificData } from '@config/cv.json';
import Other from '@/icons/other.astro';

import { colors } from '@config/styles.json';
const { titlesColor, secondaryFontColor } = colors;

const projectsFromExperience = Array.isArray(experience?.projects)
  ? experience.projects
  : [];

const normalizedProjects =
  projectsFromExperience.length > 0
    ? projectsFromExperience.map((project) => {
        const role: any = Array.isArray(project.roles)
          ? project.roles[0]
          : undefined;
        const startDate = role?.startDate;
        const finishDate = role?.finishDate;

        const startYear = startDate
          ? new Date(startDate).getFullYear().toString()
          : '';
        const endYear = finishDate
          ? new Date(finishDate).getFullYear().toString()
          : startYear
            ? 'Actualmente'
            : '';

        return {
          name: project?.details?.name ?? '',
          description: project?.details?.description ?? '',
          url: project?.details?.URL ?? '',
          years: startYear ? `${startYear} - ${endYear}` : '',
        };
      })
    : Array.isArray(manfredSpecificData?.projects)
      ? manfredSpecificData.projects.map((project) => ({
          name: project?.name ?? '',
          description: '',
          url: '',
          years: '',
        }))
      : [];

const projects = normalizedProjects.filter((project) => project.name);
---

{
  projects.length > 0 && (
    <Section title="Proyectos personales">
      <ul>
        {
          projects.map(({ name, description, url, years }) => {
            return (
              <li>
                <article>
                  <header>
                    <div>
                      <a href={url || '#'} title={name} target="_blank">
                        <div class="link-svg">
                          <Other color={titlesColor} />
                        </div>
                        <h3>{name}</h3>
                      </a>
                    </div>
                    {years && <time>{years}</time>}
                  </header>
                  {description && (
                    <footer>
                      <p>{description}</p>
                    </footer>
                  )}
                </article>
              </li>
            );
          })
        }
      </ul>
    </Section>
  )
}

<style define:vars={{ titlesColor, secondaryFontColor }}>
  .link-svg {
    margin-right: 0.5em;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-bottom: 2.5em;
  }

  li {
    display: flex;
    width: 100%;
  }

  article {
    width: 100%;
  }

  figure img {
    margin-right: 1.5rem;
    border-radius: 0.2em;
  }

  article h3 {
    font-weight: 500;
    color: var(--titlesColor);
  }

  article a {
    color: var(--titlesColor);
    display: flex;
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: var(--titlesColor);
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: var(--secondaryFontColor);
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }

    li {
      flex-direction: column;
    }

    figure img {
      margin-top: 0.5rem;
    }
  }
</style>
