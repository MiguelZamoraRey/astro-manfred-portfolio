---
import Section from "@/components/Section.astro";

import Mail from "@/icons/Mail.astro";
import WorldMap from "@/icons/WorldMap.astro";
import twitter from "@/icons/twitter.astro";
import other from "@/icons/other.astro";
import linkedin from "@/icons/linkedin.astro";
import github from "@/icons/github.astro";
import Phone from "@/icons/Phone.astro";
import Download from "@/icons/Download.astro";

import cvPdf from "@config/cv.pdf";
import { aboutMe, careerPreferences } from "@config/cv.json";
//import { contact } from '@config/external.json';

const { profile, relevantLinks } = aboutMe;
const { name, surnames, title, avatar, location } = profile;
const { link } = avatar;
const { country, region, municipality } = location;

import { colors } from "@config/styles.json";
import Other from "@/icons/other.astro";
const { heroTitle, heroSecondary, heroFrom, heroTo } = colors;

const contact: any = careerPreferences?.contact ?? {};

const fallbackEmail = Array.isArray(contact.contactMails)
  ? contact.contactMails[0]
  : undefined;

const fallbackPhone = Array.isArray(contact.contactPhones)
  ? contact.contactPhones[0]
  : Array.isArray(contact.contactPhoneNumbers)
    ? contact.contactPhoneNumbers[0]
    : Array.isArray(contact.phones)
      ? contact.phones[0]
      : undefined;

const allProfiles = [
  ...(Array.isArray(relevantLinks) ? relevantLinks : []),
  ...(Array.isArray(contact.publicProfiles) ? contact.publicProfiles : []),
];

const manfredProfile = allProfiles.find((profile: any) => {
  const type = String(profile?.type ?? "").toLowerCase();
  const url = String(profile?.URL ?? "").toLowerCase();

  return type.includes("manfred") || url.includes("manfred");
});

const email = import.meta.env.PUBLIC_EMAIL || fallbackEmail;
const phone = import.meta.env.PUBLIC_PHONE || fallbackPhone;
const manfred = import.meta.env.PUBLIC_MANFRED || manfredProfile?.URL;

const uniqueRelevantLinks = allProfiles.filter(
  (profile: any, index: number) => {
    if (!profile?.URL) return false;
    if (manfred && profile.URL === manfred) return false;

    return (
      allProfiles.findIndex(
        (candidate: any) => candidate?.URL === profile.URL,
      ) === index
    );
  },
);

const SOCIAL_ICONS: Record<string, any> = {
  github,
  linkedin,
  other,
  twitter,
};
---

<div class="context">
  <Section>
    <div class="container">
      <div class="info">
        <h1>{name} {surnames}</h1>
        <h2>{title}</h2>
        <span
          ><WorldMap color={heroSecondary} />
          {municipality}, {region}, {country}</span
        >
        <footer>
          {
            (
              <>
                <a
                  class="long-btn"
                  href={cvPdf}
                  title={`Descargar el cv de ${name} en pdf`}
                  target="_blank"
                >
                  <Download color={heroSecondary} /> <span>Descargar CV</span>
                </a>
              </>
            )
          }
          {
            email && (
              <a
                href={`mailto:${email}`}
                title={`Enviar un correo electrónico a ${name} el correo ${email}`}
                target="_blank"
              >
                <Mail color={heroSecondary} />
              </a>
            )
          }
          {
            phone && (
              <a
                href={`tel:${phone}`}
                title={`Contacter con ${name} en el teléfono ${phone}`}
                target="_blank"
              >
                <Phone color={heroSecondary} />
              </a>
            )
          }
          {
            manfred && (
              <a
                href={`${manfred}`}
                title={`Ver el cv de ${name} en Manfred`}
                target="_blank"
              >
                <Other color={heroSecondary} />
              </a>
            )
          }
          {
            uniqueRelevantLinks.map(({ type, URL }) => {
              const normalizedType = String(type ?? "").toLowerCase();
              const Icon = SOCIAL_ICONS[normalizedType] ?? Other;

              return (
                <a
                  href={URL}
                  title={`Visitar el perfil de ${name} en ${type}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon color={heroSecondary} />
                </a>
              );
            })
          }
        </footer>
      </div>
      <figure>
        <img src={link} alt={name} />
      </figure>
    </div>
  </Section>
</div>
<div class="area">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
</div>

<style define:vars={{ heroTitle, heroSecondary, heroFrom, heroTo }}>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    z-index: 200;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }

  h1 {
    font-size: 2rem;
    color: var(--heroTitle);
  }

  h2 {
    color: var(--heroTitle);
    font-weight: 500;
    font-size: 1.9rem;
    text-wrap: balance;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 200px;
    border-radius: 50%;
    border: 2px solid rgba(200, 135, 58, 0.35);
  }

  span {
    color: var(--heroSecondary);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }

  footer {
    color: #555;
    font-size: 0.65rem;
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  footer a {
    color: #777;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--heroSecondary);
    padding: 4px;
    height: 54px;
    width: 54px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  footer a:hover {
    background: rgba(200, 135, 58, 0.1);
    border-color: var(--heroSecondary);
    color: var(--heroSecondary);
  }

  .long-btn {
    width: 13em !important;
  }

  .long-btn span {
    display: block;
  }

  .context {
    width: 100%;
    position: absolute;
    top: 18vh;
    z-index: 2;
  }

  .scroll-cta,
  .scroll-line,
  .scroll-label {
    display: none;
  }

  .area {
    background: linear-gradient(160deg, var(--heroFrom) 0%, var(--heroTo) 100%);
    width: 100%;
    height: 80vh;
    z-index: 1;
    position: relative;
    overflow: hidden;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .area::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(200, 135, 58, 0.3),
      transparent
    );
    pointer-events: none;
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    figure {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    h2 {
      text-wrap: balance;
    }

    figure {
      margin: 0 auto;
    }

    .area {
      height: 95vh;
    }

    .long-btn {
      width: 5em !important;
    }

    .long-btn span {
      display: none;
    }
  }
</style>

<script>
  (function () {
    const canvas = document.querySelector<HTMLCanvasElement>(".hero-canvas");
    if (!canvas) return;
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (prefersReduced) return;

    const ctx = canvas.getContext("2d")!;
    const ACCENT = "200, 135, 58";
    const NODE_COUNT = 55;
    const MAX_DIST = 140;
    const SPEED = 0.35;

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
    }

    let W = 0,
      H = 0;
    const nodes: Node[] = [];

    function resize() {
      W = canvas.offsetWidth;
      H = canvas.offsetHeight;
      canvas.width = W;
      canvas.height = H;
    }

    function init() {
      nodes.length = 0;
      for (let i = 0; i < NODE_COUNT; i++) {
        const angle = Math.random() * Math.PI * 2;
        nodes.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: Math.cos(angle) * SPEED * (0.4 + Math.random() * 0.6),
          vy: Math.sin(angle) * SPEED * (0.4 + Math.random() * 0.6),
          r: 1.5 + Math.random() * 1.5,
        });
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);

      // connections
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MAX_DIST) {
            const alpha = (1 - dist / MAX_DIST) * 0.28;
            ctx.beginPath();
            ctx.strokeStyle = `rgba(${ACCENT}, ${alpha})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }

      // nodes
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${ACCENT}, 0.55)`;
        ctx.fill();
      }
    }

    function update() {
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > W) n.vx *= -1;
        if (n.y < 0 || n.y > H) n.vy *= -1;
      }
    }

    let raf: number;
    function loop() {
      update();
      draw();
      raf = requestAnimationFrame(loop);
    }

    resize();
    init();
    loop();

    const ro = new ResizeObserver(() => {
      resize();
      init();
    });
    ro.observe(canvas.parentElement!);
  })();
</script>
