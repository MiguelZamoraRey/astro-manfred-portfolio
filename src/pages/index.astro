---
import Layout from "@/layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Skills from "@/components/sections/Skills.astro";
import Languages from "@/components/sections/Languages.astro";
import Projects from "@/components/sections/Projects.astro";
import Recommended from "@/components/sections/Recommended.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";

import { colors } from "@config/styles.json";
const { bgColor, secondaryBg } = colors;

const showSkills = import.meta.env.PUBLIC_SHOW_SKILLS !== "N";
const showProjects = import.meta.env.PUBLIC_SHOW_PROJECTS !== "N";
const showEducation = import.meta.env.PUBLIC_SHOW_EDUCATION == "Y";
const showLanguages = import.meta.env.PUBLIC_SHOW_LANGUAGES == "Y";
const showRecommended = import.meta.env.PUBLIC_SHOW_RECOMMENDED !== "N";
---

<Layout title="Portfolio Miguel Zamora Rey - Full Stack developer">
  <main>
    <Hero />
    <div class="secondBg">
      <About />
      {showSkills && <Skills />}
      {showRecommended && <Recommended />}
      <br />
    </div>
    {/*<section class="spikes"></section>*/}
    <Experience />
    {/*<section class="spikes2"></section>*/}
    <div class="secondBg">
      {showProjects && <Projects />}
      {showEducation && <Education />}
      {showLanguages && <Languages />}
      {/*<section class="spikes"></section>*/}
    </div>

    <footer class="publi">
      <div class="publi-inner">
        <span class="publi-line"></span>
        <span class="publi-text">
          <a
            href="https://www.mzrdeveloper.com/"
            target="_blank"
            rel="noopener noreferrer">Miguel Zamora Rey</a
          >
          &nbsp;&mdash;&nbsp;{new Date().getFullYear()}
        </span>
        <span class="publi-line"></span>
      </div>
    </footer>
  </main>
  <KeyboardManager />
</Layout>

<style define:vars={{ bgColor, secondaryBg }}>
  main {
    /*padding: 4rem;*/
    margin: auto;
    width: 100%;
  }

  .secondBg {
    background-color: var(--secondaryBg);
  }

  .spikes {
    position: relative;
    background: var(--secondaryBg);
    height: 2vh;
    margin-bottom: 2vh;
  }

  .spikes::after {
    content: "";
    position: absolute;
    right: 0;
    left: -0%;
    top: 100%;
    z-index: 10;
    display: block;
    height: 50px;
    background-size: 50px 100%;
    background-image:
      linear-gradient(135deg, var(--secondaryBg) 25%, transparent 25%),
      linear-gradient(225deg, var(--secondaryBg) 25%, transparent 25%);
    background-position: 0 0;
  }

  .spikes2 {
    position: relative;
    background: var(--bgColor);
    height: 2vh;
  }

  .spikes2::after {
    content: "";
    position: absolute;
    right: 0;
    left: -0%;
    top: 100%;
    z-index: 10;
    display: block;
    height: 50px;
    background-size: 50px 100%;
    background-image:
      linear-gradient(135deg, var(--bgColor) 25%, transparent 25%),
      linear-gradient(225deg, var(--bgColor) 25%, transparent 25%);
    background-position: 0 0;
  }

  .publi {
    width: 100%;
    padding: 2.5rem 2rem;
    margin-top: 1rem;
  }

  .publi-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .publi-line {
    flex: 1;
    height: 1px;
    background: rgba(200, 135, 58, 0.15);
    display: block;
  }

  .publi-text {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: "Sora", sans-serif;
    color: #6e6b65;
    white-space: nowrap;
  }

  .publi-text a {
    color: #c8873a;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .publi-text a:hover {
    opacity: 1;
  }
</style>
