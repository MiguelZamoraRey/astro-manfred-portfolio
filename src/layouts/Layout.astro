---
interface Props {
  title: string;
}

const { title } = Astro.props;

import {
  aboutMe,
  careerPreferences,
  experience,
  settings,
} from "@config/cv.json";

const { profile, relevantLinks } = aboutMe;
const { link } = profile.avatar;
const siteUrl = "https://mzrdeveloper.com";
const canonicalUrl = Astro.url
  ? new URL(Astro.url.pathname, siteUrl).toString()
  : `${siteUrl}/`;

const fullName = `${profile.name} ${profile.surnames}`;

const publicProfiles = Array.isArray(
  (careerPreferences as any)?.contact?.publicProfiles,
)
  ? (careerPreferences as any).contact.publicProfiles
  : [];

const sameAs = [
  ...(Array.isArray(relevantLinks) ? relevantLinks : []),
  ...publicProfiles,
]
  .map((profile: any) => profile?.URL)
  .filter((url: string | undefined) => Boolean(url));

const projects = Array.isArray((experience as any)?.projects)
  ? (experience as any).projects
  : [];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      name: "MZR Developer",
      url: siteUrl,
      description: profile.title,
      inLanguage: "es",
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: fullName,
      jobTitle: profile.title,
      description: profile.description,
      image: link,
      url: `${siteUrl}/`,
      sameAs,
      homeLocation: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressLocality: profile.location.municipality,
          addressRegion: profile.location.region,
          addressCountry: profile.location.country,
        },
      },
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/#profile`,
      url: `${siteUrl}/`,
      inLanguage: "es",
      mainEntity: {
        "@id": `${siteUrl}/#person`,
      },
    },
    {
      "@type": "ItemList",
      "@id": `${siteUrl}/#projects`,
      name: "Proyectos personales",
      itemListElement: projects.map((project: any, index: number) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "CreativeWork",
          name: project?.details?.name,
          description: project?.details?.description,
          url: project?.details?.URL,
        },
      })),
    },
  ],
};

import { colors } from "@config/styles.json";
const { bgColor, fontColor } = colors;
const accentColor = (colors as any).accentColor ?? "#c8873a";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={profile.title} />
    <meta name="robots" content="index,follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={bgColor} />
    <meta name="geo.region" content={settings.language} />
    <meta name="language" content="es" />
    <meta name="author" content={fullName} />
    <!--Facebook meta tags -->
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={profile.title} />
    <meta property="og:image" content={link} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />

    <!--Tritter meta tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={siteUrl} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={link} />
    <title>{title}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:global define:vars={{ bgColor, fontColor, accentColor }}>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      body {
        background-color: var(--bgColor);
        color: var(--fontColor);
        font-family:
          "Source Sans 3",
          -apple-system,
          system-ui,
          sans-serif;
        margin: 0;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      h1,
      h2,
      h3,
      h4 {
        font-family: "Sora", sans-serif;
      }
      a {
        text-decoration: none;
      }
      @media (prefers-reduced-motion: no-preference) {
        [data-reveal] {
          opacity: 0;
          transform: translateY(18px);
          transition:
            opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
            transform 0.45s cubic-bezier(0.16, 1, 0.3, 1)
              var(--reveal-delay, 0ms);
        }
        [data-reveal].is-visible {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      (function () {
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (prefersReduced) {
          document.querySelectorAll("[data-reveal]").forEach(function (el) {
            el.classList.add("is-visible");
          });
          return;
        }
        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              const parent = el.parentElement;
              const siblings = parent
                ? Array.from(parent.querySelectorAll("[data-reveal]"))
                : [el];
              const idx = siblings.indexOf(el);
              (el as HTMLElement).style.setProperty(
                "--reveal-delay",
                Math.min(idx * 70, 280) + "ms",
              );
              el.classList.add("is-visible");
              observer.unobserve(el);
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -24px 0px" },
        );
        document.querySelectorAll("[data-reveal]").forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
<style is:global define:vars={{ bgColor, fontColor }}>
  html {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: var(--bgColor);
    letter-spacing: -0.02rem;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul,
  li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
    color: var(--fontColor);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }
</style>
